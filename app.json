{
  "expo": {
    "name": "NivassHub",
    "slug": "nivasshub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nivasshub",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A237E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koundinyasatech.nivasshub"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A237E"
      },
      "package": "com.koundinyasatech.nivasshub",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ]
    ],
    "newArchEnabled": true,
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "7325fa8a-f26b-4fae-972c-2b13f6c184e9"
      }
    }
  }
}
